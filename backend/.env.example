# Copie para .env e preencha. Nunca commitar o .env real.

NODE_ENV=development
PORT=3003
APP_URL=http://localhost:3003
FRONTEND_URL=http://localhost:5173

# ── Oracle (owner PAINELPDVC5IA — sem acesso de escrita ao schema Consinco) ──
ORACLE_USER=PAINELPDVC5IA
ORACLE_PASSWORD=
ORACLE_CONNECTION_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=172.19.0.169)(PORT=1521))(CONNECT_DATA=(SID=DESENV20)))
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_QUERY_TIMEOUT_MS=10000

# ── JWT — gere segredos fortes e distintos (ex.: openssl rand -base64 48) ────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ── Acesso do desenvolvedor (não existe em nenhuma tabela do banco) ─────────
# Gere o hash com (dentro de backend/, após `npm install`):
#   node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA_AQUI', 12))"
ADMIN_CODUSUARIO=admin
ADMIN_SENHA_HASH=

# ── Cookies ───────────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
# true em producao (HTTPS obrigatorio para cookie Secure)
COOKIE_SECURE=false

# ── Rate limiting de login ───────────────────────────────────────────────
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5

LOG_LEVEL=info
# true em dev local (usa pino-pretty); manter false em produção/Docker.
LOG_PRETTY=true

# ── Verificação de rede dos PDVs (ping) ──────────────────────────────────
# Só funciona em ambientes com rota até a rede das lojas (192.168.x.x) —
# em dev local isso normalmente NÃO existe, então deixe PDV_PING_HABILITADO
# como false (senão cada ciclo só reporta tudo como offline à toa). Ligar
# como true só no ambiente de produção real, que tem essa rota.
PDV_PING_HABILITADO=false
# Intervalo entre ciclos de ping (ms). 300000 = 5 minutos.
PDV_PING_INTERVALO_MS=300000
# Timeout de cada ping individual, em segundos.
PDV_PING_TIMEOUT_S=1
# Quantos pings rodam em paralelo por ciclo (limite pra não abrir processos
# demais de uma vez — tem ~1300 PDVs no total).
PDV_PING_CONCORRENCIA=50
